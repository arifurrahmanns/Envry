{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Envry",
  "mainBinaryName": "envry-desktop",
  "identifier": "io.github.arifurrahmanns.envry",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": { "script": "node scripts/sidecar.mjs", "wait": true },
    "beforeBuildCommand": "node scripts/sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/envry"],
    "publisher": "Envry",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Local email testing server",
    "longDescription": "Envry captures every email your app sends over SMTP, keeps it local, and serves it back over POP3, IMAP, a REST API and a web UI.",
    "homepage": "https://github.com/arifurrahmanns/envry",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
